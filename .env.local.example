# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase Configuration (database & storage only — auth handled by Clerk)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://restrip.vercel.app

# Crop Backend Configuration
# Set to "local" to use the local Python server, or "runpod" (default) for cloud
CROP_BACKEND=runpod
LOCAL_CROP_URL=http://localhost:8000/crop

# RunPod Configuration (Server-side only, used when CROP_BACKEND=runpod)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated list of allowed origins (supports wildcard patterns like *.vercel.app)
NEXT_PUBLIC_ALLOWED_ORIGINS=*.vercel.app

# Telegram Bot Configuration
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET= # for personal use

ENCRYPTION_SECRET=<generate your own encryption secret>